{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PurbayaLog",
  "version": "1.0.0",
  "identifier": "com.purbayalog.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PurbayaLog - Logbook Aktivitas Mahasiswa",
        "width": 1320,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
